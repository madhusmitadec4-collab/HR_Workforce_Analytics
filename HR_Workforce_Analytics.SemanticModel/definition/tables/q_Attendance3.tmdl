table q_Attendance3
	lineageTag: c8d664d2-51a6-4201-88d7-9ab5991bccb2

	measure Actual_Attrition_Rate = DIVIDE(CALCULATE(COUNTROWS(q_Employees1),q_Employees1[Employment_Status]="Resigned"),COUNTROWS(q_Employees1),0)
		lineageTag: 064b667a-f92f-4c85-b135-b2952fd4c4cc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Attrition_Risk_Rate = DIVIDE(CALCULATE(COUNTROWS(q_Employees1),q_Employees1[Employment_Status] IN {"Resigned","On Notice"}),COUNTROWS(q_Employees1),0)
		lineageTag: d545a961-b536-486d-94cb-9bf9168c3d2a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Recruitment Rate' = DIVIDE(CALCULATE(COUNTROWS(q_Recruitment2),q_Recruitment2[Application_Status]="Joined"),COUNTROWS(q_Recruitment2),0)
		lineageTag: 52d1194d-c38c-4946-a959-9e234169bad1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Training Completion Rate' = DIVIDE(CALCULATE(COUNTROWS(q_Training4),q_Training4[Training_Status]="Completed"),COUNTROWS(q_Training4),0)
		lineageTag: 5ddf0622-8dfe-4280-a016-85a438dd215c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'High Performers' = CALCULATE(COUNTROWS(q_Performance5),q_Performance5[Performance_Rating]>=4)
		formatString: 0
		lineageTag: c959d666-3928-436b-a61e-cb1420b74243

	measure 'Low Performers' = CALCULATE(COUNTROWS(q_Performance5),q_Performance5[Performance_Rating]<=2)
		formatString: 0
